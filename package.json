{
  "name": "shiyin-local",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "build": "vue-tsc --noEmit && vite build && node scripts/build-verification.mjs",
    "start": "tsx server/index.ts --production",
    "test": "tsx --test tests/*.test.ts",
    "test:ui": "node scripts/check-workspace-ui.mjs",
    "check": "tsc --noEmit -p tsconfig.server.json",
    "desktop:build": "npm run build && node scripts/build-desktop.mjs",
    "desktop": "npm run desktop:build && electron .",
    "desktop:pack": "node scripts/package-desktop.mjs",
    "test:desktop": "node scripts/check-desktop.mjs"
  },
  "dependencies": {
    "@lucide/vue": "^1.73.0",
    "express": "^5.1.0",
    "multer": "^2.0.0",
    "playwright": "^1.65.1",
    "qrcode": "^1.5.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "soda-decrypt": "latest",
    "tsx": "^4.20.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@types/express": "latest",
    "@types/multer": "latest",
    "@types/node": "latest",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "latest",
    "electron": "45.3.3",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "prettier": "^3.10.1",
    "typescript": "^5.9.0",
    "vite": "latest",
    "vue-tsc": "latest"
  },
  "engines": {
    "node": ">=24"
  },
  "main": "desktop/main.cjs",
  "desktopName": "shiyin.desktop",
  "description": "拾音：汽水音乐与抖音视频本地音频工具",
  "homepage": "https://github.com/xiaoyoumi9924/shiyin",
  "author": "xiaoyoumi9924"
}
